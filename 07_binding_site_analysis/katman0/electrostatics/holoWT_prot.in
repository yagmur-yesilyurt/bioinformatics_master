read
    mol pqr holoWT_prot.pqr
end
elec
    mg-auto
    dime 97 97 97
    cglen 253.9 253.9 253.9
    fglen 175.1 175.1 175.1
    cgcent mol 1
    fgcent mol 1
    mol 1
    lpbe
    bcfl sdh
    ion charge 1 conc 0.150 radius 2.0
    ion charge -1 conc 0.150 radius 2.0
    pdie 2.0
    sdie 78.54
    srfm smol
    chgm spl2
    sdens 10.0
    srad 1.4
    swin 0.3
    temp 310.0
    calcenergy no
    calcforce no
    write pot dx holoWT_prot_pot
end
